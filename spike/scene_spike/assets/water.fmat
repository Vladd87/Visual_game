// Spike: stream water. Vertex ripples + flow-scrolled procedural normals,
// refraction from scene color, depth-based absorption from scene depth.
material {
  name: "SpikeWater",
  shading_model: lit,
  blending: alpha,
  culling: none,
  engine_inputs: [ scene_color, scene_depth ],
  parameters: [
    { type: vec2, name: flow, default: [0.0, 0.35] },
    { type: vec3, name: deep_color, default: [0.02, 0.05, 0.05] },
    { type: float, name: absorption, default: 3.0 },
    { type: float, name: refraction_strength, default: 0.03 },
    { type: float, name: anim_time, default: 0.0 },
  ],
}

vertex {
  void Vertex(inout VertexInputs vertex) {
    float t = material_params.anim_time;
    vec3 p = vertex.world_position;
    float h = 0.006 * sin(p.x * 9.0 + t * 1.7) * cos(p.z * 7.0 - t * 2.3);
    vertex.world_position = p + vec3(0.0, h, 0.0);
  }
}

fragment {
  float Hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }

  float ValueNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(Hash12(i), Hash12(i + vec2(1.0, 0.0)), u.x),
               mix(Hash12(i + vec2(0.0, 1.0)), Hash12(i + vec2(1.0, 1.0)), u.x),
               u.y);
  }

  float Height(vec2 p) {
    return ValueNoise(p) * 0.6 + ValueNoise(p * 2.7 + 13.1) * 0.3 +
           ValueNoise(p * 6.3 - 7.7) * 0.1;
  }

  void Surface(inout MaterialInputs material) {
    float t = GetTime();
    vec3 wp = GetWorldPosition();
    vec2 flow = material_params.flow;
    // Two flow phases cross-faded so the scroll never stretches (flow-map style).
    float ph0 = fract(t * 0.25);
    float ph1 = fract(t * 0.25 + 0.5);
    float w = abs(ph0 * 2.0 - 1.0);
    vec2 uvA = wp.xz * 6.0 - flow * ph0 * 4.0;
    vec2 uvB = wp.xz * 6.0 - flow * ph1 * 4.0 + 0.5;
    float e = 0.05;
    float hA = Height(uvA);
    float hB = Height(uvB);
    vec2 gA = vec2(Height(uvA + vec2(e, 0.0)) - hA, Height(uvA + vec2(0.0, e)) - hA);
    vec2 gB = vec2(Height(uvB + vec2(e, 0.0)) - hB, Height(uvB + vec2(0.0, e)) - hB);
    vec2 g = mix(gA, gB, w) / e;
    vec3 n = normalize(vec3(-g.x * 0.08, 1.0, -g.y * 0.08));

    // Refraction: offset the scene-color lookup by the normal; absorb by thickness.
    vec2 offset = n.xz * material_params.refraction_strength;
    float sceneDepth = GetSceneDepth(offset);
    float thickness = max(sceneDepth - GetFragmentViewDepth(), 0.0);
    vec3 refracted = GetSceneColor(offset);
    vec3 transmittance = exp(-material_params.absorption * thickness *
                             vec3(1.0, 0.55, 0.45));

    material.normal = n;
    material.base_color = vec4(0.0, 0.0, 0.0, 1.0);
    material.metallic = 0.0;
    material.roughness = 0.04;
    material.emissive = refracted * transmittance +
                        material_params.deep_color * (1.0 - transmittance) * 0.05;
  }
}
