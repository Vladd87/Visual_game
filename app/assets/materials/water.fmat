// LANTERN stream water (M2, round 2).
//
// Per-vertex data from the CPU (render/terrain.dart):
//   color.rg = surface flow in sim axes, encoded v * 2 + 0.5 (m/s)
//   color.b  = foam potential (rock fronts, trailing wakes, faint bank lines)
//   color.a  = turbulence near rocks
//
// Shading:
// - flow-mapped, flow-stretched ripple normals (two cross-faded phases)
// - refraction of the opaque scene behind (pebble bed, rocks), placed by refracting
//   the view ray through the ripple normal over the measured water depth
// - depth absorption, with in-scatter lit by the lantern
// - a planar reflection (lantern, rocks, banks, fireflies), distorted by the ripples
//   and Fresnel-weighted; the lit model's IBL specular supplies the sky where
//   nothing is mirrored
// - streaky, partially transparent foam advected with the current
material {
  name: "Water",
  shading_model: lit,
  blending: alpha,
  culling: back,
  effects_depth: true,
  engine_inputs: [ scene_color, scene_depth, planar_reflection ],
  parameters: [
    { type: sampler2d, name: normal_tex, hint: default_normal },
    { type: vec3, name: lantern_pos, default: [0, 0.03, 0] },
    { type: vec3, name: lantern_light, default: [1.0, 0.6, 0.28] },
    { type: vec3, name: ambient, default: [0.02, 0.025, 0.03] },
    { type: vec3, name: absorption, default: [4.2, 5.4, 8.0] },
    { type: vec3, name: murk, default: [0.07, 0.095, 0.085] },
    { type: float, name: normal_strength, default: 1.0 },
    { type: float, name: refraction, default: 2.5 },
    { type: float, name: foam_amount, default: 1.0 },
    { type: float, name: reflection, default: 1.0 },
  ],
}

fragment {
  vec2 SampleSlope(vec2 uv) {
    return texture(normal_tex, uv).rg * 2.0 - 1.0;
  }

  // Ripple slope at world xz, stretched along the flow and advected with it.
  vec2 RippleSlope(vec2 p, vec2 dir, float speed, float t, float scale,
                   float stretch, float seed) {
    vec2 perp = vec2(-dir.y, dir.x);
    vec2 q = vec2(dot(p, dir), dot(p, perp));
    const float cycle = 1.8;
    float ph0 = fract(t / cycle);
    float ph1 = fract(t / cycle + 0.5);
    float w0 = 1.0 - abs(ph0 * 2.0 - 1.0);
    vec2 k = vec2(scale / stretch, scale);
    vec2 a = SampleSlope((q - vec2(speed * ph0 * cycle, 0.0)) * k + seed);
    vec2 b = SampleSlope((q - vec2(speed * ph1 * cycle, 0.0)) * k + seed + 0.5);
    vec2 s = mix(b, a, w0);
    return dir * (s.x / stretch) + perp * s.y;
  }

  vec3 LanternIrradiance(vec3 p) {
    vec3 d = material_params.lantern_pos - p;
    float r2 = dot(d, d);
    float window = clamp(1.0 - r2 / 9.0, 0.0, 1.0);
    return material_params.lantern_light * (0.012 / (r2 + 0.0025)) * window * window;
  }

  // Planar reflection sampled at a ripple-displaced world point.
  vec4 Mirror(vec3 wp, vec2 slope) {
    if (planar_reflection_info.params.x < 0.5) return vec4(0.0);
    vec3 q = wp + vec3(slope.x, 0.0, slope.y) * 0.035;
    vec4 clip = planar_reflection_info.view_projection * vec4(q, 1.0);
    if (clip.w <= 0.0) return vec4(0.0);
    vec2 uv = vec2(0.5 + 0.5 * clip.x / clip.w, 0.5 - 0.5 * clip.y / clip.w);
    uv = clamp(uv, vec2(0.001), vec2(0.999));
    return texture(planar_reflection, uv);
  }

  void Surface(inout MaterialInputs material) {
    vec4 vc = GetVertexColor();
    vec2 flowSim = (vc.rg - 0.5) * 0.5;
    vec2 flowW = vec2(flowSim.x, -flowSim.y);  // world xz
    float speed = length(flowW);
    vec2 dir = speed > 1e-4 ? flowW / speed : vec2(0.0, -1.0);
    vec2 perp = vec2(-dir.y, dir.x);
    float turb = vc.a;
    float t = GetTime();
    highp vec3 wp = GetWorldPosition();
    vec2 p = wp.xz;

    // --- normals -------------------------------------------------------------
    float stretch = 1.0 + 0.9 * clamp(speed / 0.25, 0.0, 1.0);
    vec2 slope = RippleSlope(p, dir, speed * 1.1, t, 2.6, stretch, 0.0) * 0.55;
    slope += RippleSlope(p, dir, speed * 1.4, t * 1.07, 6.0, stretch * 0.8, 0.37) * (0.18 + 0.45 * turb);
    slope += SampleSlope(p * 1.3 + vec2(t * 0.013, -t * 0.009)) * 0.18;
    slope *= material_params.normal_strength * (0.55 + 0.8 * turb);
    vec3 n = normalize(vec3(-slope.x * 0.42, 1.0, -slope.y * 0.42));

    // --- refraction ------------------------------------------------------------
    vec3 v = GetViewDirection();  // toward the camera
    float fragDepth = GetFragmentViewDepth();
    float thick0 = max(GetSceneDepth(vec2(0.0)) - fragDepth, 0.0);
    // Physical bend over the measured depth, plus an amplified ripple-only part
    // (amplifying the flat bend too would overshoot past object edges).
    vec3 tFlat = refract(-v, vec3(0.0, 1.0, 0.0), 1.0 / 1.33);
    vec3 tRip = refract(-v, n, 1.0 / 1.33);
    float reach = min(thick0, 0.25);
    vec2 base = ProjectWorldOffsetToScreenUv(tFlat * reach) - GetScreenUv();
    vec2 rip = ProjectWorldOffsetToScreenUv(tRip * reach) - GetScreenUv() - base;
    vec2 off = base + rip * material_params.refraction;
    float sceneD = GetSceneDepth(off);
    float d0 = fragDepth + thick0;
    // Never sample across an object's edge: back off when the depth jumps.
    if (sceneD < fragDepth || abs(sceneD - d0) > 0.03 + thick0 * 0.5) {
      off *= 0.4;
      sceneD = GetSceneDepth(off);
      if (sceneD < fragDepth || abs(sceneD - d0) > 0.03 + thick0 * 0.5) {
        off = vec2(0.0);
        sceneD = d0;
      }
    }
    float path = clamp(sceneD - fragDepth, 0.0, 2.0);
    vec3 behind = GetSceneColor(off);
    vec3 trans = exp(-material_params.absorption * path);
    vec3 light = material_params.ambient + LanternIrradiance(wp) * 0.35;
    vec3 scatter = material_params.murk * light * (1.0 - trans.g);

    // --- Fresnel and mirror ------------------------------------------------------
    float ndv = clamp(dot(n, v), 0.0, 1.0);
    float f = 0.02 + 0.98 * pow(1.0 - ndv, 5.0);
    vec4 mir = Mirror(wp, slope * 0.42);
    float covered = clamp(mir.a, 0.0, 1.0);
    vec3 mirrored = mir.rgb * f * material_params.reflection;

    // --- foam ----------------------------------------------------------------------
    // Streaks: long along the flow, narrow across it, advected downstream.
    vec2 fq = vec2(dot(p, dir) - speed * t, dot(p, perp));
    float s1 = texture(normal_tex, fq * vec2(1.8, 3.6)).b;
    float s2 = texture(normal_tex, fq * vec2(3.6, 7.2) + 0.37).b;
    float blobs = texture(normal_tex, fq * 4.0 + 0.71).a;
    float breakup = s1 * 0.6 + s2 * 0.15 + blobs * 0.25;
    float foam = smoothstep(0.45, 0.85, vc.b * material_params.foam_amount * (0.35 + 1.1 * breakup));
    foam *= smoothstep(0.0, 0.01, thick0 + 0.004);
    float foamCover = foam * 0.7;  // thin foam lets the water show through

    // --- drifting flecks: bubbles and bits of foam riding the current -----------
    // Two cross-faded phases so the speckle pattern travels with the flow
    // without stretching; denser in wakes, sparse everywhere the water moves.
    const float fcycle = 3.2;
    float fp0 = fract(t / fcycle);
    float fp1 = fract(t / fcycle + 0.5);
    float fw0 = 1.0 - abs(fp0 * 2.0 - 1.0);
    vec2 fqa = vec2(dot(p, dir) - speed * fp0 * fcycle, dot(p, perp)) * vec2(9.0, 10.0);
    vec2 fqb = vec2(dot(p, dir) - speed * fp1 * fcycle, dot(p, perp)) * vec2(9.0, 10.0) + 0.43;
    float fa = texture(normal_tex, fqa).a;
    float fb = texture(normal_tex, fqb).a;
    float density = clamp(0.12 + vc.b * 1.4, 0.0, 1.0) * smoothstep(0.02, 0.12, speed);
    float thr = 0.86 - 0.12 * density;
    float fleck = mix(smoothstep(thr, thr + 0.035, fb), smoothstep(thr, thr + 0.035, fa), fw0) * density;
    fleck *= smoothstep(0.0, 0.01, thick0 + 0.004);
    foam = max(foam, fleck * 0.9);
    foamCover = max(foamCover, fleck * 0.8);

    // --- meniscus: a thin bright line where the water meets stone and bank -------
    float shore = 1.0 - smoothstep(0.002, 0.014, thick0);

    material.normal = normalize(mix(n, vec3(0.0, 1.0, 0.0), foam * 0.5));
    material.base_color = vec4(vec3(0.36, 0.37, 0.36) * foam, 1.0);
    material.metallic = 0.0;
    material.roughness = mix(mix(0.07, 0.03, shore), 0.6, foam);
    // Water's F0 is 0.02; 0.04 here (a mild, deliberate cheat) so the dusk-sky
    // sheen reads. Where an object is mirrored, its reflection replaces the sky.
    material.specular = (1.0 + 0.6 * shore) * (1.0 - covered);
    material.emissive = ((behind * trans + scatter) * (1.0 - f) + mirrored) * (1.0 - foamCover);
    material.occlusion = 1.0;
  }
}
