// LANTERN rocks: CC0 photogrammetry scans (Poly Haven rock_moss_set_01/02)
// with wetness by height above the water (y = 0):
//   submerged: near-black and saturated (refs 08, 13),
//   splash band (0-5 cm): darkest, glossy wet stone with a biofilm line at
//                         the waterline (refs 01, 03, 13),
//   above: damp from the light rain; moss caps on the upward faces
//          (ambientCG Moss001, planar from above) stay matte (refs 03, 09).
// Instance colour carries a small per-rock tint (rgb) so repeats differ.
material {
  name: "Rock",
  shading_model: lit,
  culling: back,
  parameters: [
    // Four samplers: the rock set's packed pair and the bank atlas (moss
    // caps). Android guarantees only 16 per fragment shader and the engine's
    // lit pipeline uses about ten (lib/render/surface_pack.dart).
    { type: sampler2d, name: r_t1, hint: default_white },
    { type: sampler2d, name: r_t2, hint: default_white },
    { type: sampler2d, name: s_t1, hint: default_white },
    { type: sampler2d, name: s_t2, hint: default_white },
    { type: float, name: damp, default: 0.35 },
  ],
}

fragment {
  vec3 DecodeNormalXY(vec2 t) {
    vec2 xy = t * 255.0 / 127.0 - 128.0 / 127.0;
    return vec3(xy, sqrt(max(1.0 - dot(xy, xy), 0.0)));
  }

  // Moss tile of the padded bank atlas (see ground.fmat / surface_pack.dart).
  vec4 MossTap(sampler2D t, highp vec2 uv, vec2 dx, vec2 dy) {
    highp vec2 a = (vec2(1088.0, 0.0) + 32.0 + fract(uv) * 1024.0) / 2176.0;
    vec2 gx = dx * (1024.0 / 2176.0);
    vec2 gy = dy * (1024.0 / 2176.0);
    float m = max(length(gx), length(gy)) * 2176.0;
    if (m > 24.0) {
      gx *= 24.0 / m;
      gy *= 24.0 / m;
    }
    return textureGrad(t, a, gx, gy);
  }

  void Surface(inout MaterialInputs material) {
    vec2 uv = GetUV0();
    vec4 t1 = texture(r_t1, uv);
    vec4 t2 = texture(r_t2, uv);
    vec3 srgb = t1.rgb;
    vec3 col = SRGBToLinear(srgb) * GetVertexColor().rgb;
    vec3 arh = vec3(t2.b, t1.a, t2.a);
    vec3 geo = GetWorldNormal();
    mat3 tbn = TangentFrame(geo, -v_viewvector, uv);
    vec3 n = normalize(tbn * DecodeNormalXY(t2.rg));
    highp vec3 wp = GetWorldPosition();
    float y = wp.y;

    // Stream stone is greyer and darker than these sunlit scans (refs 03, 13).
    float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
    col = mix(vec3(lum), col, 0.65) * 0.8;

    // Moss already in the scan's albedo: greener than it is red or blue.
    float scanMoss = smoothstep(0.015, 0.07, srgb.g - srgb.b) * smoothstep(-0.03, 0.03, srgb.g - srgb.r);
    float rough = arh.g;

    float under = smoothstep(0.003, -0.012, y);
    float band = (1.0 - under) * (1.0 - smoothstep(0.0, 0.05, y));
    float line = (1.0 - under) * (1.0 - smoothstep(0.0, 0.01, y));
    float damp = material_params.damp;

    // Moss caps: upward faces clear of the splash zone, in patches.
    highp vec2 mp = wp.xz / 0.3;
    vec2 mdx = dFdx(mp), mdy = dFdy(mp);
    vec4 m1 = MossTap(s_t1, mp, mdx, mdy);
    vec4 m2 = MossTap(s_t2, mp, mdx, mdy);
    vec3 ma = vec3(m2.b, m1.a, m2.a);
    highp vec2 pp = wp.xz * 0.9 + 0.37;
    float patchField = MossTap(s_t2, pp, dFdx(pp), dFdy(pp)).a;
    float up = smoothstep(0.35, 0.8, geo.y);
    float dry = smoothstep(0.03, 0.07, y);
    float cap = up * dry * clamp((patchField - 0.42 + ma.b * 0.4 + up * 0.15) * 5.0, 0.0, 1.0);
    if (cap > 0.0) {
      vec3 mc = SRGBToLinear(m1.rgb);
      vec3 mn = DecodeNormalXY(m2.rg);
      col = mix(col, mc * 0.8, cap);
      n = normalize(mix(n, normalize(geo + vec3(mn.x, 0.0, -mn.y) * 0.8), cap));
      rough = mix(rough, 0.85, cap);
      arh.r = mix(arh.r, ma.r, cap);
    }
    float moss = max(scanMoss, cap);

    // Wet darkening: water fills the pores (stone darkens more than moss).
    float wet = max(max(damp, band), under);
    col *= mix(1.0, mix(0.5, 0.72, moss), wet);
    // Submerged: a faint olive biofilm and more saturation.
    col = mix(col, col * vec3(0.82, 0.92, 0.7), under * 0.6);
    // Dark biofilm stain at the waterline.
    col *= 1.0 - 0.4 * line;
    // Micro shadowing from the scan's AO (direct light too, not just ambient).
    col *= mix(1.0, arh.r, 0.45);

    // A water film smooths the surface and makes bare stone glossy.
    float film = max(band, under) * (1.0 - moss * 0.7);
    n = normalize(mix(n, geo, film * 0.5));
    rough = mix(rough, rough * 0.75, damp * (1.0 - moss));
    rough = mix(rough, 0.07, band * (1.0 - moss * 0.8));
    rough = mix(rough, 0.25, under);

    material.base_color = vec4(col, 1.0);
    material.normal = n;
    material.metallic = 0.0;
    material.roughness = clamp(rough, 0.05, 1.0);
    material.occlusion = arh.r;
    // Submerged stone loses its sheen; the water surface takes the highlight.
    material.specular = mix(1.0, 0.08, under);
  }
}
