// LANTERN rocks: CC0 photogrammetry scans (Poly Haven rock_moss_set_01/02)
// with wetness by height above the water (y = 0):
//   submerged: dark and saturated (refs 08, 13),
//   splash band (0-4.5 cm): darkest, glossy wet stone with a biofilm line
//                           at the waterline (refs 01, 03, 13),
//   above: damp from the light rain, moss stays matte (refs 04, 09, 12).
// Instance colour carries a small per-rock tint (rgb) so repeats differ.
material {
  name: "Rock",
  shading_model: lit,
  culling: back,
  parameters: [
    { type: sampler2d, name: col_tex, hint: default_white },
    { type: sampler2d, name: nrm_tex, hint: default_normal },
    { type: sampler2d, name: arh_tex, hint: default_white },
    { type: float, name: damp, default: 0.35 },
  ],
}

fragment {
  void Surface(inout MaterialInputs material) {
    vec2 uv = GetUV0();
    vec3 srgb = texture(col_tex, uv).rgb;
    vec3 col = SRGBToLinear(srgb) * GetVertexColor().rgb;
    vec3 arh = texture(arh_tex, uv).rgb;
    vec3 geo = GetWorldNormal();
    vec3 n = PerturbNormal(nrm_tex, geo, v_viewvector, uv, 1.0);
    highp vec3 wp = GetWorldPosition();
    float y = wp.y;

    // Moss in the scan's albedo: greener than it is red or blue.
    float moss = smoothstep(0.015, 0.07, srgb.g - srgb.b) * smoothstep(-0.03, 0.03, srgb.g - srgb.r);
    float rough = arh.g;

    float under = smoothstep(0.003, -0.012, y);
    float band = (1.0 - under) * (1.0 - smoothstep(0.0, 0.045, y));
    float line = (1.0 - under) * (1.0 - smoothstep(0.0, 0.012, y));
    float damp = material_params.damp;

    // Wet darkening: water fills the pores (stone darkens more than moss).
    float wet = max(max(damp, band), under);
    col *= mix(1.0, mix(0.55, 0.72, moss), wet);
    // Submerged: a faint olive biofilm and more saturation.
    col = mix(col, col * vec3(0.82, 0.92, 0.7), under * 0.6);
    // Dark biofilm stain at the waterline.
    col *= 1.0 - 0.35 * line;
    // Micro shadowing from the scan's AO (direct light too, not just ambient).
    col *= mix(1.0, arh.r, 0.45);

    // A water film smooths the surface and makes bare stone glossy.
    float film = max(band, under) * (1.0 - moss * 0.7);
    n = normalize(mix(n, geo, film * 0.45));
    rough = mix(rough, rough * 0.8, damp * (1.0 - moss));
    rough = mix(rough, 0.12, band * (1.0 - moss * 0.8));
    rough = mix(rough, 0.3, under);

    material.base_color = vec4(col, 1.0);
    material.normal = n;
    material.metallic = 0.0;
    material.roughness = clamp(rough, 0.08, 1.0);
    material.occlusion = arh.r;
  }
}
