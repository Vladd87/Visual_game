// LANTERN ground (stream bed and banks).
//
// Banks (M3): photographed CC0 surfaces, planar-mapped from above with a
// two-tap rotation detile:
//   forest ground (ambientCG Ground037) everywhere,
//   moss cushions (ambientCG Moss001) in patches, lusher near the water,
//   wet mud (Poly Haven brown_mud_02) in a ragged band at the waterline,
//   with puddle gloss in its low spots (refs 07, 08, 09, 11).
// Bed: a procedural pebble bed (round stones of mixed size partly buried in
// silt, per-stone tone, domed normals, algae film) so refraction and caustics
// read like refs 08/09; gravel mounds under rocks show more stones.
// Caustics: lantern light focused by the rippled surface (baked pattern, two
// advected layers, slight chromatic split), additive only.
//
// Vertex colour: r = rock mound weight, g = distance out of the channel
// (0..1 over 1.5 m), b = contact occlusion beside rocks.
material {
  name: "Ground",
  shading_model: lit,
  parameters: [
    { type: sampler2d, name: caustic_tex, hint: default_black },
    { type: sampler2d, name: noise_tex, hint: default_black },
    { type: sampler2d, name: g_col, hint: default_white },
    { type: sampler2d, name: g_nrm, hint: default_normal },
    { type: sampler2d, name: g_arh, hint: default_white },
    { type: sampler2d, name: m_col, hint: default_white },
    { type: sampler2d, name: m_nrm, hint: default_normal },
    { type: sampler2d, name: m_arh, hint: default_white },
    { type: sampler2d, name: u_col, hint: default_white },
    { type: sampler2d, name: u_nrm, hint: default_normal },
    { type: sampler2d, name: u_arh, hint: default_white },
    { type: vec3, name: lantern_pos, default: [0, 0.03, 0] },
    { type: vec3, name: lantern_light, default: [1.0, 0.6, 0.28] },
    { type: vec3, name: ambient, default: [0.02, 0.025, 0.03] },
    { type: float, name: caustic_strength, default: 1.0 },
    { type: float, name: damp, default: 0.35 },
  ],
}

fragment {
  vec2 Hash22(vec2 p) {
    vec3 a = fract(p.xyx * vec3(123.34, 234.34, 345.65));
    a += dot(a, a + 34.45);
    return fract(vec2(a.x * a.y, a.y * a.z));
  }

  float Hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }

  // Round pebbles partly buried in silt: for each nearby cell, a disc of random
  // radius around a jittered centre (not Voronoi tiles, which read as paving).
  // Returns stone coverage, the offset to the winning centre (in cell units),
  // that stone's radius and id.
  float Pebbles(vec2 p, out vec2 toCenter, out float radius, out vec2 cellId) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    float best = 0.0;
    toCenter = vec2(1.0);
    radius = 1.0;
    cellId = i;
    for (int y = -1; y <= 1; y++) {
      for (int x = -1; x <= 1; x++) {
        vec2 g = vec2(float(x), float(y));
        vec2 h = Hash22(i + g);
        vec2 r = g + h * 0.7 + 0.15 - f;
        float rad = 0.22 + 0.3 * Hash12(i + g + 3.1);
        // Slightly elongated stones with random orientation.
        float a = Hash12(i + g + 9.7) * 6.2831;
        vec2 ax = vec2(cos(a), sin(a));
        vec2 rr = vec2(dot(r, ax), dot(r, vec2(-ax.y, ax.x))) * vec2(0.8, 1.25);
        float d = length(rr);
        float cover = smoothstep(rad, rad * 0.82, d);
        if (cover > best) {
          best = cover;
          toCenter = rr / rad;
          radius = rad;
          cellId = i + g;
        }
      }
    }
    return best;
  }

  vec3 LanternIrradiance(vec3 p) {
    vec3 d = material_params.lantern_pos - p;
    float r2 = dot(d, d);
    float window = clamp(1.0 - r2 / 9.0, 0.0, 1.0);
    return material_params.lantern_light * (0.012 / (r2 + 0.0025)) * window * window;
  }

  float Caustic(vec2 uv) {
    return texture(caustic_tex, uv).r * 4.0;
  }

  vec3 DecodeNormal(vec3 t) {
    return t * 255.0 / 127.0 - 128.0 / 127.0;
  }

  // One photographed surface, sampled twice (second tap rotated and offset)
  // and blended by low-frequency noise and the surface's own height, so the
  // 1 m tiles never repeat visibly. Returns linear albedo, tangent-space
  // normal (in uv's frame) and AO/roughness/height.
  void SampleSurface(sampler2D colT, sampler2D nrmT, sampler2D arhT, vec2 uv, float blend,
                     out vec3 col, out vec3 tn, out vec3 arh) {
    const mat2 R = mat2(0.6, 0.8, -0.8, 0.6);
    vec2 uv2 = R * uv + vec2(0.43, 0.17);
    vec3 a1 = texture(arhT, uv).rgb;
    vec3 a2 = texture(arhT, uv2).rgb;
    // Steep, height-led transition: one photo or the other, not a cross-fade
    // (a soft blend of two taps reads as a painterly smear).
    float t = clamp((blend - 0.5) * 7.0 + 0.5 + (a2.b - a1.b) * 4.0, 0.0, 1.0);
    col = SRGBToLinear(mix(texture(colT, uv).rgb, texture(colT, uv2).rgb, t));
    vec3 n1 = DecodeNormal(texture(nrmT, uv).rgb);
    vec3 n2 = DecodeNormal(texture(nrmT, uv2).rgb);
    n2.xy = transpose(R) * n2.xy;
    tn = normalize(mix(n1, n2, t));
    arh = mix(a1, a2, t);
  }

  void Surface(inout MaterialInputs material) {
    vec4 vc = GetVertexColor();
    highp vec3 wp = GetWorldPosition();
    float t = GetTime();
    vec2 p = wp.xz;
    float mound = vc.r;
    float out_d = vc.g;
    float contact = vc.b;
    float under = smoothstep(0.004, -0.012, wp.y);   // below the water surface
    float wet = smoothstep(0.012, -0.004, wp.y);     // pebble bed up to just above it
    float damp = material_params.damp;
    vec3 geo = GetWorldNormal();

    float n1 = texture(noise_tex, p * 0.23).a;
    float n2 = texture(noise_tex, p * 0.71 + 0.3).a;
    float n3 = texture(noise_tex, p * 2.3 + 0.7).a;

    vec3 albedo = vec3(0.1);
    vec3 n = geo;
    float rough = 0.9;
    float ao = 1.0;

    if (wet < 0.999) {
      // ---- Banks ----
      highp vec2 uv = p;
      mat3 tbn = CotangentFrame(geo, -v_viewvector, uv);
      vec3 gc, gn, ga;
      SampleSurface(g_col, g_nrm, g_arh, uv / 0.9, n1, gc, gn, ga);
      vec3 col = gc;
      vec3 tn = gn;
      vec3 arh = ga;
      float above = wp.y;
      // Moss cushions: patchy, favoured on flatter ground near the water,
      // never in the mud band; the edge follows the moss's own height.
      // Noise A is ~N(0.53, 0.1): this gives ~40 % cushions, more on level
      // ground near the water, with dark bare earth and litter between.
      float level = smoothstep(0.75, 0.95, geo.y);
      float near = 1.0 - smoothstep(0.0, 0.5, out_d);
      // Two patch scales: whole mossy zones vs bare litter zones (~3 m), and
      // cushions within them.
      float zone = texture(noise_tex, p * 0.045 + 0.71).a;
      float mossField = n1 * 0.45 + n2 * 0.3 + (zone - 0.53) * 0.9 + 0.13 + (level - 0.7) * 0.06 + near * 0.06;
      // Mud only along the stream margin (out_d is metres / 1.5), never in
      // hollows further up the bank; its width varies, and in places moss and
      // ground run down to the water instead (refs 07, 13).
      float mudTop = 0.02 + 0.07 * n1;
      float mudBand = (1.0 - smoothstep(mudTop - 0.02, mudTop + 0.02, above + (n3 - 0.5) * 0.03)) *
                      (1.0 - smoothstep(0.06, 0.14, out_d)) *
                      smoothstep(0.38, 0.5, texture(noise_tex, p * 0.31 + 0.53).a);
      float mossW = 0.0;
      if (mossField > 0.4) {
        vec3 mc, mn, ma;
        SampleSurface(m_col, m_nrm, m_arh, uv / 0.45, n2, mc, mn, ma);
        mossW = clamp((mossField - 0.54 + (ma.b - 0.44) * 0.35) * 9.0, 0.0, 1.0) * (1.0 - mudBand);
        col = mix(col, mc, mossW);
        tn = normalize(mix(tn, mn, mossW));
        arh = mix(arh, ma, mossW);
      }
      float mudW = 0.0;
      if (mudBand > 0.0) {
        vec3 uc, un, ua;
        SampleSurface(u_col, u_nrm, u_arh, uv / 0.6, n3, uc, un, ua);
        mudW = clamp(mudBand * 1.4 - (ua.b - 0.5) * 0.6, 0.0, 1.0);
        col = mix(col, uc, mudW);
        tn = normalize(mix(tn, un, mudW));
        arh = mix(arh, ua, mudW);
      }
      n = normalize(tbn * tn);
      rough = arh.g;
      ao = arh.r;
      // Damp from the rain: soil darkens and gets a little glossier; moss
      // darkens but stays matte.
      col *= mix(1.0, mix(0.6, 0.8, mossW), damp);
      // Large, soft light/dark patches (litter, soil moisture).
      col *= 0.8 + 0.4 * texture(noise_tex, p * 0.09 + 0.21).a;
      rough = mix(rough, rough * 0.8, damp * (1.0 - mossW));
      // Saturated mud at the waterline, with puddles in its low spots.
      // Whatever reaches the waterline is soaked (moss and soil too).
      float nearWater = 1.0 - smoothstep(0.0, 0.035, above);
      float soak = max(mudW * (1.0 - smoothstep(0.0, 0.05, above)), nearWater * 0.85);
      col *= mix(1.0, 0.62, soak);
      float puddle = mudW * soak * (1.0 - smoothstep(0.3, 0.42, arh.b));
      rough = mix(rough, 0.25, soak);
      rough = mix(rough, 0.04, puddle);
      n = normalize(mix(n, geo, puddle));
      col *= mix(1.0, ao, 0.5);
      albedo = col;
    }

    if (wet > 0.0) {
      // ---- Pebble bed ----
      // Patches: cobble-rich areas vs silty gravel (low-frequency mask).
      float patchy = smoothstep(0.35, 0.75, texture(caustic_tex, p * 0.35 + 0.17).r * 2.0);
      patchy = max(patchy, mound);
      vec2 tc, id;
      float rad;
      float stone = Pebbles(p * 22.0 + vec2(17.3, -4.1), tc, rad, id);
      vec2 tc2, id2;
      float rad2;
      float pebble = Pebbles(p * 55.0, tc2, rad2, id2) * 0.85;
      stone *= mix(0.55, 1.0, patchy);
      // Sparse big cobbles (8-14 cm) in the cobble-rich patches.
      vec2 tc3, id3;
      float rad3;
      float cobble = Pebbles(p * 9.0 + vec2(-3.7, 8.2), tc3, rad3, id3);
      cobble *= step(0.45, Hash12(id3 + 1.3)) * smoothstep(0.3, 0.7, patchy);
      // Silt/sand flats bury most stones in the slow areas (not on mounds).
      float flats = smoothstep(0.55, 0.85, texture(caustic_tex, p * 0.21 + 0.61).r * 2.2) * (1.0 - mound);
      stone *= 1.0 - 0.75 * flats;
      float h = Hash12(id);
      float h2 = Hash12(id + 7.7);
      // Muted stream-stone tones (refs 08, 09): grey, slate, ochre, olive; a few pale.
      vec3 tone = mix(vec3(0.19, 0.18, 0.165), vec3(0.27, 0.23, 0.17), h);
      tone = mix(tone, vec3(0.14, 0.145, 0.14), step(0.7, h2));
      tone = mix(tone, vec3(0.32, 0.30, 0.26), step(0.92, h2));
      vec3 small = mix(vec3(0.16, 0.14, 0.11), vec3(0.24, 0.21, 0.16), Hash12(id2));
      float grain = 0.88 + 0.24 * Hash12(floor(p * 300.0));
      vec3 silt = vec3(0.085, 0.072, 0.052) * grain;
      vec3 bed = mix(silt, small * grain, pebble);
      bed = mix(bed, tone * grain, stone);
      vec3 cobbleTone = mix(vec3(0.17, 0.165, 0.15), vec3(0.25, 0.22, 0.17), Hash12(id3 + 4.2));
      bed = mix(bed, cobbleTone * grain, cobble);
      bed = mix(bed, vec3(0.13, 0.115, 0.085) * grain, flats * (1.0 - cobble) * 0.7);
      // A film of olive algae and silt settles over everything in slack water.
      float film = smoothstep(0.3, 0.8, texture(caustic_tex, p * 0.9 + 0.5).r * 2.0);
      bed = mix(bed, bed * vec3(0.8, 0.86, 0.62), film * 0.6);
      bed *= 0.65;
      // Domed stone normals.
      float dome = max(max(stone, pebble * 0.6), cobble);
      vec2 slope = (cobble > 0.5 ? tc3 : (stone >= pebble ? tc : tc2)) * dome * 0.9;
      vec3 pn = normalize(vec3(slope.x, 1.0, slope.y));
      albedo = mix(albedo, bed, wet);
      n = normalize(mix(n, pn, wet));
      rough = mix(rough, mix(0.7, 0.35, dome), wet);
      ao = mix(ao, 1.0, wet);
    }

    // Contact shadow where rocks meet the ground.
    albedo *= 1.0 - 0.3 * contact * contact;
    ao *= 1.0 - 0.5 * contact;

    material.base_color = vec4(albedo, 1.0);
    material.normal = n;
    material.metallic = 0.0;
    material.roughness = clamp(rough, 0.04, 1.0);
    material.occlusion = ao;
    if (under > 0.0) {
      // Two caustic layers drifting downstream (-Z) at different scales/speeds.
      vec2 u1 = p * 3.0 + vec2(0.012, 0.05) * t;
      vec2 u2 = p * 2.4 * mat2(0.8, -0.6, 0.6, 0.8) + vec2(-0.02, 0.07) * t;
      // Geometric mean of two layers: crisp bright filaments where they cross.
      vec3 c;
      c.r = sqrt(Caustic(u1 + 0.0012) * Caustic(u2 + 0.0012));
      c.g = sqrt(Caustic(u1) * Caustic(u2));
      c.b = sqrt(Caustic(u1 - 0.0012) * Caustic(u2 - 0.0012));
      c = pow(c, vec3(1.6)) * 0.85;
      float depth = -wp.y;
      float focus = smoothstep(0.0, 0.03, depth) * (1.0 - smoothstep(0.15, 0.4, depth));
      vec3 light = LanternIrradiance(wp) + material_params.ambient * 0.6;
      vec3 gain = max(c * 1.6 - vec3(0.55), vec3(0.0)) * focus * under * material_params.caustic_strength;
      material.emissive = albedo * light * gain;
    }
  }
}
