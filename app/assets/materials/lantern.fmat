// LANTERN paper (M7): candle light seen through the paper panels of a
// floating toro nagashi lantern (ref02).
// UV: x = panel index + across the panel (0-1), y = up the panel (0 at the
// tray, 1 at the rim).
// What ref02 shows, bottom to top:
//  - a deeper orange band where the wooden base inside blocks the flame;
//  - a pale hot spot just above it, the flame behind the paper;
//  - peach-apricot paper above, a little dimmer toward the rim;
//  - a column of large brushed characters in dark ink;
//  - barely any frame: the folded paper corners are a little darker.
// The candle light does not reach these panels (light channels): their glow
// is all emission, so it stays amber instead of clipping to white.
material {
  name: "LanternPaper",
  shading_model: lit,
  culling: none,
  parameters: [
    { type: float, name: glow, default: 1.0 },
    { type: vec3, name: tint, default: [1.0, 0.42, 0.13] },
    { type: float, name: inner, default: 0.6 },
    { type: vec3, name: cam, default: [0.0, 5.0, -5.0] },
    { type: float, name: yaw, default: 0.0 },
  ],
}

fragment {
  // Sine-free hash with highp intermediates (as ground.fmat). On the
  // phone materials run at 16-bit precision, where sin(x) * 43758 lands on
  // multiples of 8 and its fract is always 0: every brush stroke collapsed
  // to one faint bar and the paper fibre went flat (device screenshots, M7).
  float Hash(highp vec2 p) {
    p = mod(p, 289.0);
    highp vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }

  float VNoise(highp vec2 p) {
    highp vec2 i = floor(p);
    vec2 f = vec2(fract(p));
    vec2 w = f * f * (3.0 - 2.0 * f);
    float a = Hash(i), b = Hash(i + vec2(1.0, 0.0));
    float c = Hash(i + vec2(0.0, 1.0)), d = Hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
  }

  // Distance from p to the segment a-b, and where along it (0-1).
  vec2 Segment(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return vec2(length(pa - ba * h), h);
  }

  // One brushed character in a unit cell: five strokes, mostly horizontal
  // and vertical, some slanted, each thicker where the brush lands.
  float Glyph(vec2 q, float seed) {
    float ink = 0.0;
    for (int k = 0; k < 5; k++) {
      float fk = float(k);
      float h1 = Hash(vec2(seed, fk));
      float h2 = Hash(vec2(seed + 7.1, fk));
      float h3 = Hash(vec2(seed + 3.3, fk));
      float h4 = Hash(vec2(seed + 5.9, fk));
      vec2 a, b;
      if (h1 < 0.45) {
        // horizontal
        float y = 0.12 + 0.76 * h2;
        a = vec2(0.08 + 0.3 * h3, y);
        b = vec2(0.92 - 0.3 * h4, y + 0.08 * (h3 - 0.5));
      } else if (h1 < 0.8) {
        // vertical
        float x = 0.15 + 0.7 * h2;
        a = vec2(x, 0.92 - 0.25 * h3);
        b = vec2(x + 0.06 * (h4 - 0.5), 0.08 + 0.3 * h4);
      } else {
        // slanted sweep
        a = vec2(0.2 + 0.6 * h2, 0.85 - 0.2 * h3);
        b = a + vec2(h4 < 0.5 ? -0.35 : 0.35, -0.45);
      }
      vec2 s = Segment(q, a, b);
      // The brush lands heavy and lifts thin.
      float w = mix(0.12, 0.06, s.y);
      ink = max(ink, 1.0 - smoothstep(w * 0.6, w, s.x));
    }
    return ink;
  }

  // M11: real characters in place of the made-up glyphs, which the critics
  // read as "made-up marks that only look like CJK" once the bigger lantern
  // made them legible (round 41). 平和 ("peace", common on toro nagashi) on
  // two opposite panels, 心 ("heart") on the other two. Strokes in a unit
  // cell, y up; each lands heavy and lifts thin.
  float Stroke(vec2 q, vec2 a, vec2 b) {
    vec2 s = Segment(q, a, b);
    float w = mix(0.085, 0.05, s.y);
    return 1.0 - smoothstep(w * 0.65, w, s.x);
  }

  float Kanji(vec2 q, int id) {
    float k = 0.0;
    if (id == 0) {
      // 平
      k = max(k, Stroke(q, vec2(0.18, 0.84), vec2(0.82, 0.86)));
      k = max(k, Stroke(q, vec2(0.30, 0.72), vec2(0.40, 0.56)));
      k = max(k, Stroke(q, vec2(0.70, 0.72), vec2(0.60, 0.56)));
      k = max(k, Stroke(q, vec2(0.08, 0.44), vec2(0.92, 0.46)));
      k = max(k, Stroke(q, vec2(0.50, 0.86), vec2(0.50, 0.04)));
    } else if (id == 1) {
      // 和: 禾 then 口
      k = max(k, Stroke(q, vec2(0.40, 0.94), vec2(0.12, 0.86)));
      k = max(k, Stroke(q, vec2(0.06, 0.68), vec2(0.46, 0.70)));
      k = max(k, Stroke(q, vec2(0.26, 0.88), vec2(0.26, 0.04)));
      k = max(k, Stroke(q, vec2(0.25, 0.64), vec2(0.04, 0.30)));
      k = max(k, Stroke(q, vec2(0.28, 0.60), vec2(0.44, 0.44)));
      k = max(k, Stroke(q, vec2(0.56, 0.68), vec2(0.56, 0.26)));
      k = max(k, Stroke(q, vec2(0.56, 0.68), vec2(0.92, 0.68)));
      k = max(k, Stroke(q, vec2(0.92, 0.68), vec2(0.90, 0.26)));
      k = max(k, Stroke(q, vec2(0.56, 0.30), vec2(0.90, 0.30)));
    } else {
      // 心
      k = max(k, Stroke(q, vec2(0.10, 0.52), vec2(0.18, 0.30)));
      k = max(k, Stroke(q, vec2(0.30, 0.70), vec2(0.34, 0.16)));
      k = max(k, Stroke(q, vec2(0.34, 0.16), vec2(0.78, 0.16)));
      k = max(k, Stroke(q, vec2(0.78, 0.16), vec2(0.86, 0.32)));
      k = max(k, Stroke(q, vec2(0.48, 0.76), vec2(0.58, 0.58)));
      k = max(k, Stroke(q, vec2(0.74, 0.66), vec2(0.88, 0.48)));
    }
    return k;
  }

  void Surface(inout MaterialInputs material) {
    highp vec2 uv = GetUV0();
    float panel = floor(float(uv.x));
    float u = float(fract(uv.x));
    float v = float(uv.y);
    float dx = (u - 0.5) * 2.0;
    // The inside faces take the flame's light directly; the outside shows
    // what passes through the paper. A face is seen from inside when the
    // camera is behind its panel's outward normal. The normal comes from
    // the panel index (UV) turned by the lantern's yaw, and the camera
    // position is passed in: on the phone both gl_FrontFacing and the
    // interpolated normal gave the opposite answer to the browser (device
    // screenshot, M7), so nothing here depends on the rasteriser.
    vec2 nl = panel < 0.5 ? vec2(0.0, -1.0) : panel < 1.5 ? vec2(1.0, 0.0) : panel < 2.5 ? vec2(0.0, 1.0) : vec2(-1.0, 0.0);
    float cy = cos(material_params.yaw), sy = sin(material_params.yaw);
    vec2 nw = vec2(cy * nl.x + sy * nl.y, -sy * nl.x + cy * nl.y);
    highp vec3 toCam = material_params.cam - GetWorldPosition();
    float side = dot(nw, vec2(toCam.xz)) < 0.0 ? 1.0 : 0.0;

    // Light through the paper (ref02): the base band, the flame's hot spot
    // above it, then a gentle falloff to the rim.
    float band = 1.0 - smoothstep(0.15, 0.2, v);
    float hot = exp(-(dx * dx * 1.6 + (v - 0.27) * (v - 0.27) * 30.0));
    // Brightest at candle height, half as bright at the rim (round 27
    // critics: evenly lit).
    float body = mix(1.0, 0.45, smoothstep(0.2, 1.0, v)) * (1.0 - 0.25 * dx * dx);
    // M11: a stronger hot spot where the flame stands behind the paper
    // (critics: "evenly lit", "no flame hot spot"; ref10).
    float glow = mix(body, 0.5, band) + 1.8 * hot * (1.0 - band);
    // Folded corners and the rim edge: a little darker.
    float edge = mix(0.8, 1.0, smoothstep(0.0, 0.05, u) * smoothstep(1.0, 0.95, u));
    // Paper fibre: fine mottling and long vertical fibres.
    highp vec2 p = vec2(u, v) + panel * 3.7;
    float fib = 0.86 + 0.14 * VNoise(p * vec2(70.0, 110.0)) + 0.06 * (VNoise(p * vec2(5.0, 160.0)) - 0.5);

    // A column of large characters on each panel (ref02): three on two
    // opposite panels, two on the others, about 2.9 cm wide and 2 cm tall
    // on the 6.6 × 8.5 cm paper.
    float ink = 0.0;
    if (side < 0.5) {
      // M11: 平和 on panels 0 and 2, 心 on 1 and 3, about 4 cm a character.
      // Seen from outside, u runs right to left: mirror it.
      bool two = fract(panel * 0.5) < 0.25;
      float cw = 0.4, ch = 0.31;
      float c0 = two ? 0.9 - ch * 2.0 : 0.47;
      float rows = two ? 2.0 : 1.0;
      float row = floor((v - c0) / ch);
      vec2 q = vec2(0.5 - (u - 0.5) / cw, fract((v - c0) / ch));
      if (row >= 0.0 && row < rows && abs(u - 0.5) < cw * 0.5) {
        int id = two ? (row > 0.5 ? 0 : 1) : 2;
        ink = Kanji(q, id);
        // Dry-brush breaks.
        ink *= 0.75 + 0.25 * smoothstep(0.3, 0.6, VNoise(p * vec2(60.0, 90.0)));
      }
    }

    // M11: hand-folded, rained-on paper, not a clean box (critics since
    // M7). Light passes more easily through wet paper and less through a
    // fold.
    float wear = 1.0;
    // Two or three fold creases per panel: thin darker lines, a faint
    // brighter seam beside each.
    for (int k = 0; k < 3; k++) {
      float fk = float(k);
      float hc = Hash(vec2(panel * 5.3 + 2.0, fk));
      if (fk > 1.0 && hc < 0.5) break;
      vec2 a = vec2(Hash(vec2(panel, fk + 9.0)), 0.05 + 0.9 * Hash(vec2(panel + 1.7, fk)));
      vec2 b = vec2(Hash(vec2(panel + 4.1, fk)), 0.05 + 0.9 * Hash(vec2(panel + 8.3, fk)));
      vec2 sg = Segment(vec2(u, v * 1.3), vec2(a.x, a.y * 1.3), vec2(b.x, b.y * 1.3));
      float d = sg.x;
      wear *= 1.0 - 0.24 * exp(-d * d / 0.00002) + 0.08 * exp(-(d - 0.012) * (d - 0.012) / 0.00004);
    }
    // The bottom of the paper has soaked up water from the tray: more
    // translucent below a ragged tide line, with a darker dried edge.
    float tide = 0.13 + 0.06 * VNoise(vec2(u * 7.0 + panel * 3.1, panel));
    float wet = 1.0 - smoothstep(tide - 0.015, tide, v);
    float tideLine = exp(-(v - tide) * (v - tide) / 0.00005);
    wear *= mix(1.0, 1.18, wet) * (1.0 - 0.22 * tideLine);
    // Raindrops beaded on the outside: each wets a small disc (brighter)
    // with a darker rim.
    if (side < 0.5) {
      highp vec2 cg = vec2(u * 11.0, v * 14.0) + panel * 17.0;
      highp vec2 ci = floor(cg);
      vec2 cf = vec2(fract(cg));
      float hp = Hash(ci + 0.5);
      if (hp < 0.35) {
        vec2 c = 0.25 + 0.5 * vec2(Hash(ci + 3.7), Hash(ci + 7.9));
        float rr = 0.12 + 0.16 * Hash(ci + 1.3);
        float dd = length((cf - c) * vec2(1.0, 0.8)) / rr;
        wear *= 1.0 + 0.22 * (1.0 - smoothstep(0.7, 1.0, dd)) - 0.18 * exp(-(dd - 1.0) * (dd - 1.0) * 30.0);
      }
    }

    // Deeper orange where the light is weaker or passes more paper (the
    // band); paler peach in the hot spot.
    vec3 tint = material_params.tint;
    vec3 col = mix(tint * vec3(1.0, 0.75, 0.5), tint, smoothstep(0.1, 0.22, v));
    col = mix(col, tint * vec3(1.0, 1.45, 2.2), hot * (1.0 - band) * 0.7);
    // Seen through the open top, the inner faces are paler and brighter.
    col = mix(col, tint * vec3(1.0, 1.3, 1.8), side * 0.3);

    material.base_color = vec4(vec3(0.62, 0.5, 0.36) * (1.0 - 0.8 * ink), 1.0);
    material.metallic = 0.0;
    material.roughness = 0.9;
    // Wet paper is a little more saturated.
    col = mix(col, col * vec3(1.0, 0.88, 0.75), wet * 0.6);
    material.emissive = col * glow * edge * fib * wear * (1.0 - 0.88 * ink) * material_params.glow *
                        (1.0 + material_params.inner * side);
  }
}
